        "tags": [
          "Health"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "Starts GitHub OAuth login flow.",
        "responses": {
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/oauth/github/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "GitHub OAuth callback endpoint.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "Returns authentication state of current session.",
