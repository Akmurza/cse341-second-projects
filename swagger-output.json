          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/failure": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "",
        "responses": {
          "401": {
            "description": "Unauthorized"
          }
        }
