                },
                "author": {
                  "type": "string",
                  "example": "Andrew Hunt"
                },
                "genre": {
                  "type": "string",
                  "example": "Software Development"
                },
                "publishedYear": {
                  "type": "number",
                  "example": 1999
                },
                "pages": {
                  "type": "number",
                  "example": 352
                },
                "rating": {
                  "type": "number",
                  "example": 4.8
                },
                "inStock": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
