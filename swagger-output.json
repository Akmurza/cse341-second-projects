    {
      "name": "Books",
      "description": "Books CRUD routes"
    },
    {
      "name": "Receipts",
      "description": "Receipts CRUD routes"
    }
  ],
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "cookieAuth": {
      "type": "apiKey",
      "in": "cookie",
      "name": "connect.sid",
      "description": "Session cookie returned after successful OAuth login."
    }
  },
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/": {
